---
interface Props {
  title: string;
  active?: string;
}

const { title, active } = Astro.props;
import '@fontsource/bangers';
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Sanrio Ops</title>
  </head>
  <body>
    <header class="topbar">
      <div class="brand"><a href="/">SANRIO OPS</a></div>
      <nav>
        <a href="/" class={active === 'home' ? 'active' : ''}>Home</a>
        <a href="/weekly/" class={active === 'weekly' ? 'active' : ''}>Weekly</a>
        <a href="/arms-race/" class={active === 'arms' ? 'active' : ''}>Arms Race</a>
        <a href="/guides/" class={active === 'guides' ? 'active' : ''}>Guides</a>
        <a href="/r4/" class={`leaders ${active === 'r4' ? 'active' : ''}`}>R4/R5</a>
      </nav>
      <div class="server-time" id="server-time">Server time (UTC-2)</div>
    </header>
    <slot />
    <script>
      function updateTime() {
        const st = new Date(Date.now() - 2 * 3600e3);
        const el = document.getElementById('server-time');
        if (el) {
          const h = String(st.getUTCHours()).padStart(2, '0');
          const m = String(st.getUTCMinutes()).padStart(2, '0');
          el.textContent = `Server ${h}:${m} UTC-2`;
        }
      }
      updateTime();
      setInterval(updateTime, 30000);
    </script>
  </body>
</html>
